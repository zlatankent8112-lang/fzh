# Environment Variables for Hillview School Management System
# Copy this file to .env and update with your actual values

# Admin Credentials (Change these!)
ADMIN_USERNAME=headteacher
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_TEACHER_ID=2

# Teacher Credentials (Change these!)
TEACHER_USERNAME=kevin
TEACHER_PASSWORD=your_secure_teacher_password_here
TEACHER_TEACHER_ID=4

# Database Configuration
DATABASE_URL=sqlite:///hillview.db
SECRET_KEY=your_very_secure_secret_key_here

# Security Settings
CSRF_SECRET_KEY=your_csrf_secret_key_here
SESSION_TIMEOUT=3600

# Application Settings
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO

# Email Configuration (if needed)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# ==============================================
# M-PESA DARAJA API CONFIGURATION
# ==============================================
# Get credentials from: https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox
# Options: sandbox, production

MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=174379
# Production shortcode will be different

MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/callback
# Use ngrok URL for testing: https://xxxx.ngrok.io/mpesa/callback

# M-PESA Allowed IPs (for callback security)
MPESA_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208

# ==============================================
# SMS NOTIFICATIONS - AFRICA'S TALKING
# ==============================================
# Get credentials from: https://africastalking.com/
SMS_PROVIDER=test
# Options: test, africas_talking, twilio
# Set to 'test' for development (logs to console only)
# Set to 'africas_talking' or 'twilio' when you have credentials

# Africa's Talking Credentials
AFRICAS_TALKING_USERNAME=sandbox
# Production: your actual username (e.g., hillviewschool)
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key_here
# Get from: https://account.africastalking.com/apps/sandbox/settings/key
AFRICAS_TALKING_SENDER_ID=HILLVIEW
# Must be registered with Africa's Talking (alphanumeric, max 11 chars)

# HOW TO GET AFRICA'S TALKING CREDENTIALS:
# 1. Sign up at https://africastalking.com/
# 2. Verify your account
# 3. Go to "Apps" > "Sandbox" or "Production"
# 4. Copy your Username and API Key
# 5. Register your Sender ID (e.g., HILLVIEW, SCHOOL, etc.)
# 6. Update SMS_PROVIDER=africas_talking when ready

# ==============================================
# SMS NOTIFICATIONS - TWILIO (ALTERNATIVE)
# ==============================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Your Twilio phone number (must start with +)

# HOW TO GET TWILIO CREDENTIALS:
# 1. Sign up at https://www.twilio.com/try-twilio
# 2. Get free trial credits
# 3. Go to Console Dashboard
# 4. Copy Account SID and Auth Token
# 5. Get a phone number (Phone Numbers > Buy a Number)
# 6. Update SMS_PROVIDER=twilio when ready

# ==============================================
# EMAIL NOTIFICATIONS - SMTP CONFIGURATION
# ==============================================
# Email Configuration for Parent Portal (UPDATED)
# SMTP Email Configuration for sending parent portal emails
SMTP_SERVER=smtp.gmail.com
MAIL_SERVER=smtp.gmail.com
SMTP_PORT=587
MAIL_PORT=587
SMTP_USE_TLS=true
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# School Email Credentials (for sending emails)
SMTP_USERNAME=your_school_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
MAIL_USERNAME=your_school_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Email sender information
MAIL_DEFAULT_SENDER=noreply@hillviewschool.com
MAIL_REPLY_TO=info@hillviewschool.com

# Application URL (update for production)
BASE_URL=http://127.0.0.1:8080

# IMPORTANT EMAIL SETUP NOTES:
# 1. For Gmail, you'll need to:
#    - Enable 2-factor authentication
#    - Generate an app-specific password
#    - Use the app password instead of your regular password
#
# 2. For production, update BASE_URL to your actual domain:
#    BASE_URL=https://yourdomain.com
#
# 3. Gmail Setup Instructions:
#    - Create a school Gmail account (e.g., parentportal@hillviewschool.ac.ke)
#    - Enable 2-factor authentication: https://myaccount.google.com/security
#    - Generate app-specific password: https://myaccount.google.com/apppasswords
#    - Update SMTP_USERNAME with your school email
#    - Update SMTP_PASSWORD with the app-specific password
#
# 4. Alternative SMTP Providers:
#    Office 365: MAIL_SERVER=smtp.office365.com, MAIL_PORT=587
#    Yahoo: MAIL_SERVER=smtp.mail.yahoo.com, MAIL_PORT=587
#    Outlook: MAIL_SERVER=smtp-mail.outlook.com, MAIL_PORT=587
#    SendGrid: MAIL_SERVER=smtp.sendgrid.net, MAIL_PORT=587

# ==============================================
# SCHOOL INFORMATION
# ==============================================
SCHOOL_NAME=Hillview Academy
SCHOOL_PHONE=+254700000000
SCHOOL_EMAIL=info@hillviewschool.com
SCHOOL_ADDRESS=P.O. Box 12345, Nairobi, Kenya
SCHOOL_WEBSITE=https://hillviewschool.com

# ==============================================
# NOTIFICATION PREFERENCES
# ==============================================
# Enable/disable notification channels
ENABLE_SMS_NOTIFICATIONS=True
ENABLE_EMAIL_NOTIFICATIONS=True

# Notification triggers
NOTIFY_ON_PAYMENT_SUCCESS=True
NOTIFY_ON_PAYMENT_FAILURE=False
NOTIFY_ON_PAYMENT_TIMEOUT=False

# ==============================================
# REDIS CONFIGURATION (Optional)
# ==============================================
# For rate limiting and caching
REDIS_URL=redis://localhost:6379/0
# Leave empty to use in-memory storage

# Security Headers
SECURITY_HEADERS_ENABLED=True
CONTENT_SECURITY_POLICY_ENABLED=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=memory://
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=300

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# Backup Settings
BACKUP_ENABLED=True
BACKUP_INTERVAL=86400  # 24 hours
BACKUP_RETENTION_DAYS=30

# ==============================================
# TESTING & DEVELOPMENT
# ==============================================
# Test phone numbers (comma-separated)
TEST_PHONE_NUMBERS=254712345678,254723456789
# These will receive test notifications

# Test mode override
FORCE_TEST_MODE=False
# Set to True to force test mode even with real credentials

# ==============================================
# LOGGING
# ==============================================
LOG_FILE=logs/hillview.log

# ==============================================
# ANALYTICS
# ==============================================
DEFAULT_ANALYTICS_PERIOD=30
# Default number of days to show in analytics dashboard
